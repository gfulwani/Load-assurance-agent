{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.loadassurance.agent",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "sourceTemplate": {
      "id": "ui5template.basicSAPUI5ApplicationProject",
      "version": "1.40.12"
    },
    "dataSources": {
      "mainService": {
        "uri": "/api/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "LoadAssuranceAgent-display": {
          "semanticObject": "LoadAssuranceAgent",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://shipping-status",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "offline": false
  },
  "sap.fiori": {
    "registrationIds": [
      "F-LoadAssuranceAgent"
    ],
    "archeType": "transactional"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://shipping-status",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    },
    "supportedThemes": [
      "sap_horizon",
      "sap_horizon_dark",
      "sap_fiori_3",
      "sap_fiori_3_dark"
    ]
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.loadassurance.agent.view.App",
      "type": "XML",
      "async": true,
      "id": "appView"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.uxap": {},
        "sap.ui.layout": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "handleValidation": true,
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": false,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.loadassurance.agent.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "com.loadassurance.agent.view",
        "controlAggregation": "pages",
        "controlId": "appControl",
        "transition": "slide",
        "bypassed": {
          "target": "notFound"
        }
      },
      "routes": [
        {
          "pattern": "",
          "name": "worklist",
          "target": "worklist"
        },
        {
          "pattern": "scan/{delivery}/{warehouse}",
          "name": "scan",
          "target": "scan"
        },
        {
          "pattern": "scan/{delivery}/{warehouse}/hu/{huId}",
          "name": "detail",
          "target": "detail"
        },
        {
          "pattern": "notFound",
          "name": "notFound",
          "target": "notFound"
        }
      ],
      "targets": {
        "worklist": {
          "viewId": "worklist",
          "viewName": "Worklist",
          "viewLevel": 1
        },
        "scan": {
          "viewId": "scan",
          "viewName": "Scan",
          "viewLevel": 2
        },
        "detail": {
          "viewId": "detail",
          "viewName": "Detail",
          "viewLevel": 3
        },
        "notFound": {
          "viewId": "notFound",
          "viewName": "NotFound",
          "viewLevel": 4
        }
      }
    }
  }
}
