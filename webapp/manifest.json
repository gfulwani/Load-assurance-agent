{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.loadassurance.agent",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "Load Assurance Agent",
    "description": "AI-powered load assurance for SAP EWM — validates handling units before dispatch",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/load-assurance/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "offline": false
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://shipping-status",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.loadassurance.agent.view.App",
      "type": "XML",
      "async": true,
      "id": "appView"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.uxap": {},
        "sap.ui.layout": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.loadassurance.agent.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "com.loadassurance.agent.view",
        "controlAggregation": "pages",
        "controlId": "appControl",
        "transition": "slide",
        "bypassed": {
          "target": "notFound"
        }
      },
      "routes": [
        {
          "pattern": "",
          "name": "worklist",
          "target": "worklist"
        },
        {
          "pattern": "HandlingUnits/{huID}",
          "name": "detail",
          "target": "detail"
        },
        {
          "pattern": "notFound",
          "name": "notFound",
          "target": "notFound"
        }
      ],
      "targets": {
        "worklist": {
          "viewId": "worklist",
          "viewName": "Worklist",
          "viewLevel": 1
        },
        "detail": {
          "viewId": "detail",
          "viewName": "Detail",
          "viewLevel": 2
        },
        "notFound": {
          "viewId": "notFound",
          "viewName": "NotFound",
          "viewLevel": 3
        }
      }
    }
  }
}
