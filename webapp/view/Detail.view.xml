<mvc:View
    controllerName="com.loadassurance.agent.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <uxap:ObjectPageLayout
        id="objectPageLayout"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="false"
        backgroundDesign="Standard"
        busy="{detailView>/busy}"
        busyIndicatorDelay="0">

        <!-- ═══ Header ════════════════════════════════════════════════ -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="{detailView>/huId}" level="H2" titleStyle="H2" />
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title text="{detailView>/huId}" level="H3" titleStyle="H4" />
                </uxap:snappedHeading>
                <uxap:expandedContent>
                    <ObjectStatus
                        text="{
                            parts: ['detailView>/passed','detailView>/isBlocked'],
                            formatter: '.formatter.huPassedText'
                        }"
                        state="{
                            parts: ['detailView>/passed','detailView>/isBlocked'],
                            formatter: '.formatter.huPassedState'
                        }"
                        icon="{
                            parts: ['detailView>/passed','detailView>/isBlocked'],
                            formatter: '.formatter.huPassedIcon'
                        }"
                        inverted="true" />
                    <ObjectStatus
                        text="Delivery: {detailView>/outboundDelivery}"
                        state="Information" />
                    <ObjectStatus
                        text="Bin: {detailView>/storageBin}"
                        state="None"
                        visible="{= !!${detailView>/storageBin} }" />
                </uxap:expandedContent>
                <uxap:actions>
                    <Button
                        text="AI Resolve"
                        type="Emphasized"
                        icon="sap-icon://ai"
                        press=".onResolveException"
                        visible="{= !${detailView>/passed} }"
                        enabled="{= !${detailView>/resolving} }" />
                    <Button
                        text="Back to Scan"
                        type="Transparent"
                        icon="sap-icon://nav-back"
                        press=".onNavBack" />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <!-- ═══ Header Content ════════════════════════════════════════ -->
        <uxap:headerContent>
            <layout:HorizontalLayout allowWrapping="true">
                <layout:VerticalLayout class="sapUiSmallMarginEnd">
                    <Label text="HU Status" />
                    <Text text="{detailView>/huStatus}" class="sapUiSmallMarginTop" />
                </layout:VerticalLayout>
                <layout:VerticalLayout class="sapUiSmallMarginEnd">
                    <Label text="Weight Delta" />
                    <ObjectNumber
                        number="{
                            parts: ['detailView>/expectedWeight','detailView>/actualWeight'],
                            formatter: '.formatter.weightDeltaNumber'
                        }"
                        unit="%"
                        state="{
                            parts: ['detailView>/expectedWeight','detailView>/actualWeight'],
                            formatter: '.formatter.weightDeltaState'
                        }"
                        class="sapUiSmallMarginTop" />
                </layout:VerticalLayout>
                <layout:VerticalLayout class="sapUiSmallMarginEnd">
                    <Label text="Blocked" />
                    <ObjectStatus
                        text="{
                            path: 'detailView>/isBlocked',
                            formatter: '.formatter.booleanText'
                        }"
                        state="{= ${detailView>/isBlocked} ? 'Error' : 'Success' }"
                        class="sapUiSmallMarginTop" />
                </layout:VerticalLayout>
                <layout:VerticalLayout>
                    <Label text="Closed" />
                    <ObjectStatus
                        text="{
                            path: 'detailView>/isClosed',
                            formatter: '.formatter.booleanText'
                        }"
                        state="{= ${detailView>/isClosed} ? 'Warning' : 'None' }"
                        class="sapUiSmallMarginTop" />
                </layout:VerticalLayout>
            </layout:HorizontalLayout>
        </uxap:headerContent>

        <!-- ═══ Sections ══════════════════════════════════════════════ -->
        <uxap:sections>

            <!-- ─── Weight Analysis ────────────────────────────────── -->
            <uxap:ObjectPageSection title="Weight Analysis" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="Measurements">
                        <uxap:blocks>
                            <VBox class="sapUiSmallMargin">
                                <form:SimpleForm
                                    editable="false"
                                    layout="ResponsiveGridLayout"
                                    labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                                    columnsXL="2" columnsL="2" columnsM="1">
                                    <form:content>
                                        <Label text="Expected Weight" />
                                        <ObjectNumber
                                            number="{
                                                path: 'detailView>/expectedWeight',
                                                type: 'sap.ui.model.type.Float',
                                                formatOptions: { maxFractionDigits: 3, minFractionDigits: 3 }
                                            }"
                                            unit="{detailView>/weightUnit}" />

                                        <Label text="Actual Weight (Gross)" />
                                        <ObjectNumber
                                            number="{
                                                path: 'detailView>/actualWeight',
                                                type: 'sap.ui.model.type.Float',
                                                formatOptions: { maxFractionDigits: 3, minFractionDigits: 3 }
                                            }"
                                            unit="{detailView>/weightUnit}" />

                                        <Label text="Weight Delta" />
                                        <ObjectNumber
                                            number="{
                                                parts: ['detailView>/expectedWeight','detailView>/actualWeight'],
                                                formatter: '.formatter.weightDeltaNumber'
                                            }"
                                            unit="%"
                                            state="{
                                                parts: ['detailView>/expectedWeight','detailView>/actualWeight'],
                                                formatter: '.formatter.weightDeltaState'
                                            }" />

                                        <Label text="Weight Passed" />
                                        <ObjectStatus
                                            text="{
                                                path: 'detailView>/weightPassed',
                                                formatter: '.formatter.booleanText'
                                            }"
                                            state="{= ${detailView>/weightPassed} ? 'Success' : 'Error' }" />

                                        <Label text="Storage Bin" />
                                        <Text text="{detailView>/storageBin}" />

                                        <Label text="EWM HU Status" />
                                        <Text text="{detailView>/huStatus}" />
                                    </form:content>
                                </form:SimpleForm>

                                <!-- Issue box -->
                                <MessageStrip
                                    text="{detailView>/issue}"
                                    type="Error"
                                    showIcon="true"
                                    showCloseButton="false"
                                    class="sapUiSmallMarginTop"
                                    visible="{= !!${detailView>/issue} }" />
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- ─── AI Resolution ───────────────────────────────────── -->
            <uxap:ObjectPageSection
                title="AI Resolution"
                titleUppercase="false"
                visible="{= !${detailView>/passed} }">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="Exception &amp; Resolution">
                        <uxap:blocks>
                            <VBox class="sapUiSmallMargin" width="100%">
                                <MessageStrip
                                    text="Click 'AI Resolve' in the header to get a step-by-step resolution from the AI agent."
                                    type="Information"
                                    showIcon="true"
                                    showCloseButton="false"
                                    class="sapUiSmallMarginBottom"
                                    visible="{= !${detailView>/resolutionAction} }" />
                                <MessageStrip
                                    text="{detailView>/resolutionAction}"
                                    type="Success"
                                    showIcon="true"
                                    showCloseButton="false"
                                    class="sapUiSmallMarginBottom"
                                    visible="{= !!${detailView>/resolutionAction} }" />
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>


        </uxap:sections>

    </uxap:ObjectPageLayout>
</mvc:View>
